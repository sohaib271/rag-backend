PORT=3000
FRONTEND_URL=http://localhost:5173

# Change all credentials before running outside local development.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=rag_db

GEMINI_API_KEY=replace-me

BUSINESS_TIMEZONE=Asia/Karachi
BUSINESS_OPENING_HOUR=9
BUSINESS_CLOSING_HOUR=18

# SMTP credentials used by the background booking-email worker.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Salon Bookings <bookings@example.com>"

# Used by application caching and the BullMQ email queue.
REDIS_URL=redis://localhost:6379
